# Copy to backend/.env. Never commit real credentials.
# The legacy staytus.db is preserved; this application starts with a fresh database.
DATABASE_URL=sqlite:///./staytus-app.db
APP_ENVIRONMENT=development
# API/gateway do not create tables. First run `python -m app.database_cli upgrade`.
# For an existing legacy SQLite DB: back up, then explicitly run adopt-sqlite.
# Container configuration is copied to /app/config; host development uses repo config/.
# STAYTUS_CONFIG_DIR=/app/config
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_HOURS=8
APPROVAL_MINUTES=15
AUTH_ATTEMPT_LIMIT=12
AUTH_ATTEMPT_WINDOW_SECONDS=600
POLICY_WORKER_ENABLED=true

# Use independent random secrets for shared/multi-process deployments.
# Generate each with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
CONTEXT_SECRET=
ORCHESTRATE_TOOL_KEY=

# A real IBM tenant is required for chat. Missing credentials produce 503;
# the application never substitutes a local scripted response.
ORCHESTRATE_BACKEND_URL=
ORCHESTRATE_SERVICE_URL=
ORCHESTRATE_API_KEY=
# Optional setup-script-only authoring key (Writer/Builder), scoped to this instance.
# Runtime keeps using ORCHESTRATE_API_KEY (WO User). Never expose either key in UI.
ORCHESTRATE_AUTHORING_API_KEY=
ORCHESTRATE_BEARER_TOKEN=
ORCHESTRATE_AGENT_ID=
ORCHESTRATE_CONTEXT_VERIFIED=false
ORCHESTRATE_TIMEOUT_SECONDS=90

# Optional watsonx.ai embeddings. Public capture/keyword retrieval work without them.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_API_VERSION=2024-05-31
WATSONX_EMBEDDING_MODEL=
WATSONX_GENERATION_MODEL=

# Optional Google/Microsoft mailbox OAuth. Keys/tokens remain on the backend.
# Generate once: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CONNECTOR_TOKEN_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Register the matching frontend BFF callback URI in the provider app settings:
# http://127.0.0.1:3000/api/backend/connections/google/callback
# http://127.0.0.1:3000/api/backend/connections/microsoft/callback
OAUTH_CALLBACK_BASE=http://127.0.0.1:3000/api/backend
FRONTEND_URL=http://127.0.0.1:3000

# Durable on-site reminders. Email remains off until SMTP is configured and the
# user opts in using a provider-verified connected mailbox identity.
NOTIFICATION_WORKER_ENABLED=true
# Checks only mailboxes whose owner separately enabled daily read-only monitoring.
MAIL_MONITOR_WORKER_ENABLED=true
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=465
NOTIFICATION_SMTP_SECURITY=ssl
NOTIFICATION_SMTP_USERNAME=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=
