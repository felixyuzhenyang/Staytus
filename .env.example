# Configuration reference. The backend loads backend/.env when started there.
# Copy backend/.env.example to backend/.env; keep real credentials out of Git.
DATABASE_URL=sqlite:///./staytus-app.db
APP_ENVIRONMENT=development
# Initialize with `make migrate`; see docs/DATABASE_AND_CONTAINERS.md for existing SQLite data.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_HOURS=8
APPROVAL_MINUTES=15
AUTH_ATTEMPT_LIMIT=12
AUTH_ATTEMPT_WINDOW_SECONDS=600
POLICY_WORKER_ENABLED=true
# Set strong random values before exposing a backend to the network.
CONTEXT_SECRET=
ORCHESTRATE_TOOL_KEY=
# Real IBM credentials are required for chat; unavailable services fail explicitly.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_API_VERSION=2024-05-31
WATSONX_EMBEDDING_MODEL=
WATSONX_GENERATION_MODEL=
ORCHESTRATE_BACKEND_URL=
ORCHESTRATE_SERVICE_URL=
ORCHESTRATE_API_KEY=
# Optional setup-script-only authoring key (Writer/Builder), scoped to this instance.
# Runtime keeps using ORCHESTRATE_API_KEY (WO User). Never expose either key in UI.
ORCHESTRATE_AUTHORING_API_KEY=
ORCHESTRATE_BEARER_TOKEN=
ORCHESTRATE_AGENT_ID=
ORCHESTRATE_CONTEXT_VERIFIED=false
ORCHESTRATE_TIMEOUT_SECONDS=90

# Optional mailbox OAuth. Generate CONNECTOR_TOKEN_KEY with Fernet.generate_key().
CONNECTOR_TOKEN_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Callback goes through the frontend proxy to retain the original login session.
# Register ${OAUTH_CALLBACK_BASE}/connections/google/callback (or microsoft).
OAUTH_CALLBACK_BASE=http://127.0.0.1:3000/api/backend
FRONTEND_URL=http://127.0.0.1:3000
# Next.js server only. Copy to frontend/.env.local when changing the URL.
BACKEND_URL=http://127.0.0.1:8000
